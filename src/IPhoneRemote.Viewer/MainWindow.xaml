<Window x:Class="IPhoneRemote.Viewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iPhone Remote" Width="470" Height="920" MinWidth="300" MinHeight="460"
        WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}" FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        SourceInitialized="OnSourceInitialized" Loaded="OnLoaded" Closing="OnClosing"
        PreviewKeyDown="OnPreviewKeyDown" PreviewTextInput="OnPreviewTextInput">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <DockPanel Grid.Row="0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimize" Click="OnMinimize" />
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" ToolTip="Close" Click="OnClose" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Ellipse x:Name="StateDot" Width="8" Height="8" Fill="{StaticResource Busy}" Margin="0,1,10,0" />
                <TextBlock x:Name="TitleText" Text="iPhone Remote" FontSize="13" FontWeight="SemiBold" />
                <TextBlock x:Name="StatsText" Foreground="{StaticResource Muted}" FontSize="12" Margin="10,1,0,0" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Phone -->
            <Grid Grid.Column="0" Margin="18,4,10,18">
                <Border x:Name="Bezel" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="Black" BorderBrush="#2A2A30" BorderThickness="5" Padding="0">
                    <Grid>
                        <Image x:Name="Screen" Stretch="Uniform" RenderOptions.BitmapScalingMode="Linear"
                               Cursor="Hand" SizeChanged="OnScreenSizeChanged"
                               MouseLeftButtonDown="OnMouseDown" MouseLeftButtonUp="OnMouseUp" MouseMove="OnMouseMove"
                               MouseRightButtonUp="OnRightClick" MouseWheel="OnMouseWheel" />
                        <Canvas x:Name="TouchLayer" IsHitTestVisible="False" ClipToBounds="True" />
                    </Grid>
                </Border>

                <!-- Connecting / error overlay -->
                <StackPanel x:Name="Overlay" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="300">
                    <TextBlock x:Name="OverlayIcon" Text="&#xE8EA;" FontFamily="{StaticResource Icons}" FontSize="44"
                               Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,0,0,18">
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:0.9" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                    <TextBlock x:Name="OverlayTitle" Text="Connecting" FontSize="17" FontWeight="SemiBold"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock x:Name="OverlayDetail" Text="Looking for your iPhone…" FontSize="13" Foreground="{StaticResource Muted}"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0" />
                    <Button x:Name="RetryButton" Style="{StaticResource PillButton}" Content="Try again" Margin="0,20,0,0"
                            HorizontalAlignment="Center" Visibility="Collapsed" Click="OnRetry" />
                </StackPanel>

                <!-- Toast -->
                <Border x:Name="Toast" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,26"
                        Background="#EE232327" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                        CornerRadius="16" Padding="14,8" Opacity="0" IsHitTestVisible="False">
                    <TextBlock x:Name="ToastText" FontSize="12.5" TextWrapping="Wrap" MaxWidth="280" />
                </Border>
            </Grid>

            <!-- Toolbar -->
            <Border Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,18" Padding="5,6"
                    Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="18">
                <StackPanel>
                    <Button Style="{StaticResource IconButton}" Content="&#xE80F;" ToolTip="Home  (Esc)" Click="OnHome" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE7C4;" ToolTip="App switcher  (Ctrl+E)" Click="OnAppSwitcher" />
                    <Button Style="{StaticResource IconButton}" Content="&#xEA8F;" ToolTip="Notifications  (Ctrl+N)" Click="OnNotifications" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE9E9;" ToolTip="Control Center  (Ctrl+K)" Click="OnControlCenter" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE72E;" ToolTip="Lock / wake  (Ctrl+L)" Click="OnLock" />
                    <Rectangle Height="1" Fill="{StaticResource Stroke}" Margin="8,6" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE995;" ToolTip="Volume up  (Page Up)" Click="OnVolumeUp" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE993;" ToolTip="Volume down  (Page Down)" Click="OnVolumeDown" />
                    <Rectangle Height="1" Fill="{StaticResource Stroke}" Margin="8,6" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE722;" ToolTip="Screenshot  (Ctrl+S)" Click="OnScreenshot" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE77F;" ToolTip="Paste PC clipboard as text  (Ctrl+V)" Click="OnPaste" />
                    <Button x:Name="UrlButton" Style="{StaticResource IconButton}" Content="&#xE774;" ToolTip="Open a link on the phone  (Ctrl+O)" Click="OnOpenUrl" />
                    <Rectangle Height="1" Fill="{StaticResource Stroke}" Margin="8,6" />
                    <ToggleButton x:Name="PinButton" Style="{StaticResource IconToggle}" Content="&#xE718;" ToolTip="Keep on top  (Ctrl+T)"
                                  Click="OnPinToggled" />
                    <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Settings" Click="OnSettings" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Settings flyout -->
        <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsButton}" Placement="Left"
               HorizontalOffset="-10" VerticalOffset="-200" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                    CornerRadius="14" Padding="16" Width="260">
                <StackPanel>
                    <TextBlock Style="{StaticResource FlyoutHeader}" Text="STREAM QUALITY" />
                    <Border Background="{StaticResource Surface2}" CornerRadius="9" Padding="3">
                        <UniformGrid Rows="1">
                            <RadioButton x:Name="QualitySmooth" Style="{StaticResource Segment}" Content="Smooth" GroupName="q" Checked="OnQualityChanged" />
                            <RadioButton x:Name="QualitySharp" Style="{StaticResource Segment}" Content="Sharp" GroupName="q" Checked="OnQualityChanged" />
                            <RadioButton x:Name="QualitySaver" Style="{StaticResource Segment}" Content="Saver" GroupName="q" Checked="OnQualityChanged" />
                        </UniformGrid>
                    </Border>
                    <TextBlock x:Name="QualityHint" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="2,6,0,16" TextWrapping="Wrap" />

                    <CheckBox x:Name="ShowTouchesSwitch" Style="{StaticResource Switch}" Content="Show touches" Margin="0,0,0,12"
                              Click="OnShowTouchesToggled" />
                    <CheckBox x:Name="TopmostSwitch" Style="{StaticResource Switch}" Content="Keep window on top" Margin="0,0,0,16"
                              Click="OnTopmostSwitchToggled" />

                    <TextBlock Style="{StaticResource FlyoutHeader}" Text="CONTROLS" />
                    <TextBlock Foreground="{StaticResource Muted}" FontSize="11.5" LineHeight="18" TextWrapping="Wrap">
                        Click = tap · hold or right-click = long press<LineBreak />
                        Drag = swipe · wheel = scroll · type to enter text<LineBreak />
                        F5 reconnects
                    </TextBlock>

                    <Button Style="{StaticResource PillButton}" Content="Reconnect" Background="{StaticResource Surface2}"
                            Margin="0,16,0,0" HorizontalAlignment="Left" Click="OnRetry" />
                </StackPanel>
            </Border>
        </Popup>

        <!-- Open URL flyout -->
        <Popup x:Name="UrlPopup" PlacementTarget="{Binding ElementName=UrlButton}" Placement="Left" HorizontalOffset="-10"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Opened="OnUrlPopupOpened">
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                    CornerRadius="14" Padding="12" Width="300">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PillButton}" Content="Open" Margin="8,0,0,0"
                            Padding="14,6" Click="OnUrlGo" />
                    <TextBox x:Name="UrlBox" Background="{StaticResource Surface2}" Foreground="{StaticResource Text}"
                             CaretBrush="{StaticResource Text}" BorderThickness="0" Padding="8,6" FontSize="13"
                             VerticalContentAlignment="Center" KeyDown="OnUrlKeyDown" />
                </DockPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
